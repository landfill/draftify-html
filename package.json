{
  "name": "mockspec-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Mockup-as-Spec (mockspec) — 목업을 등록하면 단독 실행 기획서 HTML을 만들어 주는 사내 서비스",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/shared",
    "packages/sdk",
    "packages/server",
    "packages/viewer",
    "fixtures/todo-app"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @mockspec/sdk",
    "typecheck": "tsc -b && npm run typecheck -w @mockspec/sdk",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "fixtures:zip": "npm run zip -w @mockspec/fixture-todo-app",
    "test:e2e": "npm run build && npm run fixtures:zip && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.20.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
