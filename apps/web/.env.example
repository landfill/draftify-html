# apps/web 환경 변수 — 실제 값은 .env.local 에 두고 커밋하지 않는다(.gitignore).
# NEXT_PUBLIC_* 는 브라우저 번들에 포함되는 공개 값이다.

# Supabase 프로젝트 (draftify-html)
NEXT_PUBLIC_SUPABASE_URL=https://dhzojuatkmafgwiwtdwe.supabase.co
# publishable(권장) 또는 legacy anon 키 — 둘 다 공개용
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 서버 전용 시크릿 — 절대 NEXT_PUBLIC_ 접두 금지, 절대 커밋 금지.
# 경로 D 토큰 인증(사용자 세션 없이 RLS 우회) 등 서버측 관리 작업에만 사용.
# Supabase 대시보드 → Settings > API Keys → secret key(sb_secret_...) 복사.
SUPABASE_SECRET_KEY=

# 로컬 개발 시 Supabase 대시보드 → Authentication → URL Configuration 에 추가:
#   Site URL: http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback
